# Firebase Admin SDK Configuration
# Get these from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Meta Pixel (public - safe for client)
NEXT_PUBLIC_META_PIXEL_ID=1407537767984552
# Meta Conversions API Token (SERVER ONLY - never prefix with NEXT_PUBLIC)
# Get from Meta Events Manager > Data Sources > Pixel > Settings > Conversions API > Generate Access Token
# Set this in Cloudflare Pages > Settings > Environment variables and in .dev.vars locally
META_CAPI_TOKEN=your_meta_capi_token_here

# Google OAuth — Sign in with Google (GSI ID token flow)
# 1) Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID (Web application)
# 2) Authorized JavaScript origins: https://muse-wear.pages.dev, http://localhost:3000
# 3) Authorized redirect not needed for GSI (ID token), but add if you later use code flow
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Server must have same ID to verify token audience (use Cloudflare secret, not NEXT_PUBLIC)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Optional: only needed if you switch to OAuth code flow (we use ID token, so not required)
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: Firebase Client Config (for client-side SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
# Taager store link (SERVER ONLY - never commit real values, never prefix with NEXT_PUBLIC).
# Your TK store key goes to TAAGER_API_TOKEN via Cloudflare secret, NOT in code:
#   npx wrangler pages secret put TAAGER_API_TOKEN --project-name=muse-wear
#   (paste the TK-... key when prompted; local dev: put it in .dev.vars which is gitignored)
# TAAGER_API_URL is the order-forwarding endpoint if Taager provides one for custom stores.
# Verified working: https://stores.api.taager.com/stores/WOOCOMMERCE/zones (public, shipping zones).
# Catalog browsing is NOT available via the TK key - import via POST /api/taager/preview|import
# (admin session) with merchant-dashboard JSON or CSV export. 50% margin applied at import.
TAAGER_API_URL=
TAAGER_API_TOKEN=
TAAGER_STORE_ID=
# --- Zero-dashboard fulfillment automation (pick ONE, no manual Taager entry) ---
# Option A: your own order webhook (n8n / Make / custom service that creates Taager order)
#   npx wrangler pages secret put TAAGER_WEBHOOK_URL --project-name=muse-wear  # e.g. https://your-n8n/webhook/muse-wear
# Option B: Taager Merchant API via Firebase (no dashboard entry — Worker auto-creates order)
#   npx wrangler pages secret put TAAGER_MERCHANT_EMAIL --project-name=muse-wear
#   npx wrangler pages secret put TAAGER_MERCHANT_PASSWORD --project-name=muse-wear
#   npx wrangler pages secret put TAAGER_FIREBASE_API_KEY --project-name=muse-wear  # from Firebase Console > Project settings > General
#   # optional override: TAAGER_MERCHANT_API_URL (default https://merchant.api.taager.com)
# Option C: Dukan storefront passthrough — auto-places via muswear.dukan.shop (Taager fulfills Dukan orders)
#   TAAGER_DUKAN_URL=https://musewear.dukan.shop
# Option D: Telegram notify (zero-dashboard alert, Worker still retries fulfillment):
#   npx wrangler pages secret put TELEGRAM_BOT_TOKEN --project-name=muse-wear
#   npx wrangler pages secret put TELEGRAM_CHAT_ID --project-name=muse-wear
TAAGER_WEBHOOK_URL=
TAAGER_MERCHANT_EMAIL=
TAAGER_MERCHANT_PASSWORD=
TAAGER_FIREBASE_API_KEY=
TAAGER_FIREBASE_ID_TOKEN=
TAAGER_MERCHANT_API_URL=
TAAGER_DUKAN_URL=https://musewear.dukan.shop
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRON_SECRET=
